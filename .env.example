>>>>>>> 5c6e07028d559e2a882b3c09e4a42b47de593077

# Only used once, by scripts/migrate-from-supabase.mjs. Remove afterwards.
SUPABASE_DB_URL=

# Paystack. From the dashboard: Settings -> API Keys & Webhooks.
# Use sk_test_/pk_test_ first; sk_live_ switches the site to real money.
#
# NOTE ON COUNTRY: Paystack registers merchants in Nigeria, Ghana, South
# Africa and Kenya (Cote d'Ivoire, Egypt and Rwanda in beta). A Lebanese
# entity cannot hold the merchant account — the merchant of record must be in
# a supported country. Customers may pay from anywhere.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# USD requires international payments enabled on the account.
PAYSTACK_CURRENCY=USD

# Webhook: point Paystack at https://<your-domain>/api/paystack/webhook
# It is the only thing that marks an order paid.
