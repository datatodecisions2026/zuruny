# Supabase — Zuruny storefront
# Shares the data-to-decisions "Hitech Bridge" project; all Zuruny tables are
# prefixed zuruny_ and are locked down with their own RLS policies.
#
# The tables are created by supabase/migrations. Run both SQL files, in order,
# in the Supabase SQL editor before checkout or the admin can use the database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
