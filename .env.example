# Supabase — Zuruny storefront
# Shares the data-to-decisions "Hitech Bridge" project; all Zuruny tables are
# prefixed zuruny_ and are locked down with their own RLS policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required to place orders: totals and the delivery region are
# written server-side so a browser can never forge them. Copy it from
# Supabase → Project Settings → API → service_role.
# Without it the site still runs; checkout falls back to the email flow.
SUPABASE_SERVICE_ROLE_KEY=

# Whish Money (Lebanon). Issued by Whish after merchant verification, along
# with the PDF that confirms the endpoint paths.
WHISH_CHANNEL=
WHISH_SECRET=
WHISH_WEBSITE_URL=https://zuruny.vercel.app
# "sandbox" or "live"
WHISH_ENV=sandbox
